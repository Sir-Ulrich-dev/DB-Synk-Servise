{
  "version": "1.0",
  "mode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(./mvnw test*)",
      "Bash(./mvnw checkstyle:check*)",
      "Bash(./mvnw clean install*)",
      "Bash(./mvnw verify*)",
      "Bash(./mvnw spring-boot:run*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Bash(cat .env*)",
      "Bash(cat .env.*)",
      "Bash(grep * .env*)",
      "Bash(rm -rf*)",
      "Bash(chmod -R 777*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)"
    ]
  },
  "tools": {
    "gitPush": {
      "requireApproval": true,
      "description": "Отправка изменений на удалённый репозиторий требует явного подтверждения"
    }
  }
}
