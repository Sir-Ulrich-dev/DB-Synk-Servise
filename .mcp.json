{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp"
      ],
      "env": {}
    },
    "trail": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@trailhq/trail-code",
        "mcp"
      ],
      "env": {}
    }
  }
}
